{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/poa/ticket-queue.schema.v2.json",
  "title": "POA revision-bound process-queue admission contracts v2",
  "description": "Closed additive family for inspecting, admitting and replacing an exact ticket-bound URI Process queue. These documents do not grant authority and do not implement a runtime.",
  "oneOf": [
    {"$ref": "#/$defs/queuePlan"},
    {"$ref": "#/$defs/queueAdmission"},
    {"$ref": "#/$defs/queueReplan"},
    {"$ref": "#/$defs/queueStart"},
    {"$ref": "#/$defs/queueAdmissionView"},
    {"$ref": "#/$defs/queueAdmissionEvent"}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9._:-]*$"
    },
    "actor": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^(?:human|agent|service|mcp):[a-zA-Z0-9._:-]+$"
    },
    "rfc3339": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "processUri": {
      "type": "string",
      "minLength": 8,
      "maxLength": 320,
      "pattern": "^[a-z][a-z0-9+.-]*://[A-Za-z0-9._~:/?#@!$&'()+,;=%-]+$"
    },
    "authorityRef": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^(?:|grant://[A-Za-z0-9._~:/?#@!$&'()+,;=%-]+)$"
    },
    "queueStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability_ref",
        "process_uri",
        "kind",
        "depends_on",
        "rollback",
        "rollback_process_uri"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "capability_ref": {"$ref": "#/$defs/processUri"},
        "process_uri": {"$ref": "#/$defs/processUri"},
        "kind": {"enum": ["query", "command"]},
        "depends_on": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "rollback": {"enum": ["automatic", "compensating", "none"]},
        "rollback_process_uri": {
          "oneOf": [
            {"const": ""},
            {"$ref": "#/$defs/processUri"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"rollback": {"const": "compensating"}}},
          "then": {"properties": {"rollback_process_uri": {"$ref": "#/$defs/processUri"}}}
        },
        {
          "if": {"properties": {"rollback": {"enum": ["automatic", "none"]}}},
          "then": {"properties": {"rollback_process_uri": {"const": ""}}}
        }
      ]
    },
    "queuePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "plan_id",
        "ticket_id",
        "queue_revision",
        "proposed_by",
        "created_at",
        "steps",
        "authority_ref",
        "hash_profile",
        "plan_hash"
      ],
      "properties": {
        "schema": {"const": "poa.queue-plan/v2"},
        "plan_id": {"$ref": "#/$defs/identifier"},
        "ticket_id": {"$ref": "#/$defs/identifier"},
        "queue_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "proposed_by": {"$ref": "#/$defs/actor"},
        "created_at": {"$ref": "#/$defs/rfc3339"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/queueStep"}
        },
        "authority_ref": {"$ref": "#/$defs/authorityRef"},
        "hash_profile": {"const": "RFC8785+SHA-256"},
        "plan_hash": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "steps": {
                "contains": {
                  "type": "object",
                  "required": ["rollback"],
                  "properties": {"rollback": {"const": "none"}}
                }
              }
            }
          },
          "then": {"properties": {"authority_ref": {"minLength": 9}}}
        }
      ]
    },
    "queueAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "admission_id",
        "ticket_id",
        "queue_revision",
        "plan_hash",
        "decision",
        "decided_by",
        "independent",
        "reason_code",
        "authority_ref"
      ],
      "properties": {
        "schema": {"const": "poa.queue-admission/v2"},
        "admission_id": {"$ref": "#/$defs/identifier"},
        "ticket_id": {"$ref": "#/$defs/identifier"},
        "queue_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "plan_hash": {"$ref": "#/$defs/sha256"},
        "decision": {"enum": ["accept", "reject"]},
        "decided_by": {"$ref": "#/$defs/actor"},
        "independent": {"const": true},
        "reason_code": {"$ref": "#/$defs/identifier"},
        "authority_ref": {"$ref": "#/$defs/authorityRef"}
      }
    },
    "queueReplan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ticket_id", "expected_queue_revision", "replacement"],
      "properties": {
        "schema": {"const": "poa.queue-replan/v2"},
        "ticket_id": {"$ref": "#/$defs/identifier"},
        "expected_queue_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "replacement": {"$ref": "#/$defs/queuePlan"}
      }
    },
    "queueStart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ticket_id", "queue_revision", "plan_hash", "executor"],
      "properties": {
        "schema": {"const": "poa.queue-start/v2"},
        "ticket_id": {"$ref": "#/$defs/identifier"},
        "queue_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "plan_hash": {"$ref": "#/$defs/sha256"},
        "executor": {"$ref": "#/$defs/actor"}
      }
    },
    "queueAdmissionView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ticket_id", "queue_revision", "state", "plan", "admission"],
      "properties": {
        "schema": {"const": "poa.queue-admission-view/v2"},
        "ticket_id": {"$ref": "#/$defs/identifier"},
        "queue_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "state": {"enum": ["planned", "rejected", "admitted", "running"]},
        "plan": {"$ref": "#/$defs/queuePlan"},
        "admission": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/queueAdmission"}
          ]
        }
      }
    },
    "queueAdmissionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "event_id",
        "event_type",
        "ticket_id",
        "queue_revision",
        "plan_hash"
      ],
      "properties": {
        "schema": {"const": "poa.queue-admission-event/v2"},
        "event_id": {"$ref": "#/$defs/identifier"},
        "event_type": {
          "enum": [
            "ProcessQueuePlanned",
            "ProcessQueueRejected",
            "ProcessQueueAdmitted",
            "ProcessQueueReplanned",
            "ProcessQueueStarted"
          ]
        },
        "ticket_id": {"$ref": "#/$defs/identifier"},
        "queue_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "plan_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
